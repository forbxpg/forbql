# Environment for forbql on the local stand (deploy/compose.yaml). Copy to .env:
#   cp .env.example .env
# forbql never reads .env by itself; pass it explicitly:
#   uv run --env-file .env forbql run "SELECT count(*) FROM accounts" \
#     --connection bank-postgres --profile analyst
#   uv run --env-file .env forbql doctor
# The values below are for the local stand only.

# Policy file for `forbql check` and `forbql run`.
FORBQL_POLICY=deploy/demo/forbql.yaml

# DSN per connection: FORBQL_DSN_ plus the connection name in upper case, with every
# other character turned into _. `--dsn` overrides it.
FORBQL_DSN_BANK_POSTGRES='postgresql://forbql_reader:forbql_reader@127.0.0.1:55433/bank?sslmode=disable&forbql-insecure=1'
FORBQL_DSN_BANK_MYSQL='mysql://forbql_reader:forbql_reader@127.0.0.1:53306/bank?ssl-mode=DISABLED&forbql-insecure=1'
# A networked DSN must set its TLS mode. The stand speaks plaintext, so these opt
# in with forbql-insecure=1. Encrypt without checking the certificate with
# ssl-mode=REQUIRED or sslmode=require; check it with
# ssl-mode=VERIFY_IDENTITY&ssl-ca=/path/to/ca.pem or sslmode=verify-full.
# Build it first: sqlite3 bank.db < deploy/demo/sqlite.sql
FORBQL_DSN_BANK_SQLITE=bank.db

# The service store: sealed DSNs and the audit chain. With it, DSNs come from the
# store (`forbql connection add`), not from FORBQL_DSN_* below, and every call is
# audited there. Leave these unset to work without it.
# FORBQL_STORE_DSN='postgresql://forbql_app:app-local-only@127.0.0.1:55432/forbql?sslmode=disable&forbql-insecure=1'
# Only `forbql store migrate` needs the owner role.
# FORBQL_STORE_OWNER_DSN='postgresql://forbql_owner:owner-local-only@127.0.0.1:55432/forbql?sslmode=disable&forbql-insecure=1'
# Key that seals DSNs in the store; make one with `forbql store keygen`. Losing it
# loses the DSNs, never the audit.
# FORBQL_SECRET_KEY=
# FORBQL_SECRET_KEY_FILE=
# The key being replaced, only for `forbql store rekey`.
# FORBQL_OLD_SECRET_KEY=
# FORBQL_OLD_SECRET_KEY_FILE=

# Audit log: JSON Lines, every record chained to the one before by its hash.
FORBQL_AUDIT_LOG=forbql-audit.jsonl

# HMAC key for the `hash` masking strategy, 32 bytes or more. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# FORBQL_MASK_KEY=
